    },
    {
      "participant": "api",
      "from": 170,
      "to": 447,
      "type": "backend"
    },
    {
      "participant": "redis",
      "from": 204,
      "to": 253,
      "type": "database"
    },
    {
      "participant": "db",
      "from": 282,
      "to": 331,
      "type": "database"
    },
    {
      "participant": "redis",
      "from": 360,
      "to": 409,
      "type": "database"
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "快路径（缓存命中）",
      "items": [
        "浏览器 → API → Redis 命中 → 直接返回，全程不碰数据库",
        "响应时间从毫秒级数据库查询降到亚毫秒级内存读取",
        "绝大多数请求走这条路径，数据库只承担首次与过期后的回源"
      ]
    },
    {
      "dot": "orange",
      "title": "慢路径（本图所示）",
      "items": [
        "Redis 返回 nil 才查询 PostgreSQL——回源是例外不是常态",
        "查到的权威数据先回填缓存再返回，让下一次请求走快路径",
        "回填必须带 TTL：即使后续删缓存失败，脏数据也只在 TTL 内存在"
      ]
    },
    {
      "dot": "rose",
      "title": "必须防的三个问题",
      "items": [
        "穿透：查不存在的 key 反复打库 → 缓存空值（短 TTL）或布隆过滤器",
        "击穿：热 key 过期瞬间大量回源 → 互斥重建，只放一个请求查库",
        "雪崩：大批 key 同时过期 → TTL 加随机抖动，避免同时回源"
      ]
    }
  ]
}
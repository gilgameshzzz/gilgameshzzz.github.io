  "cards": [
    {
      "dot": "rose",
      "title": "信任边界怎么划",
      "items": [
        "网关是唯一公网入口",
        "token 存 Redis，不是 JWT",
        "权限缓存未命中才回源用户服务",
        "外部审批回调走免认证白名单"
      ]
    },
    {
      "dot": "amber",
      "title": "两套库 + 一套事件",
      "items": [
        "MySQL 承载流程与元数据",
        "PostgreSQL 承载空间与点云",
        "Kafka 只做异步解耦",
        "不在任何同步请求链路上"
      ]
    },
    {
      "dot": "emerald",
      "title": "没画进连线的事实",
      "items": [
        "服务间共 7 个 Feign 客户端",
        "对象存储走签名 URL 直传",
        "Redis 兼作分布式锁",
        "注册中心路由变更可热更新"
      ]
    }
  ]
